# Copy to .env and replace the blank value with your own key.
# Docker Compose reads .env; go run . uses process environment variables instead.
OPENWEATHER_API_KEY=
WORKER_COUNT=4
QUEUE_SIZE=16
# Optional local Grafana password (default: local-dev-only).
# GRAFANA_ADMIN_PASSWORD=

# Application-defined alerts: high >= threshold, low <= threshold.
# Defaults: 100 F and up, 20 F and below, and 40 mph and up.
HIGH_TEMP_C=37.77777777777778
LOW_TEMP_C=-6.666666666666667
HIGH_WIND_MPS=17.8816
# go run . uses localhost:9092 by default; Compose sets kafka:29092.
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC=weather.forecasts
# KAFKA_GROUP=weather-alerts

# Optional public Grafana address, including a subpath if used during deployment.
# Otherwise dashboard links use the request hostname on port 3000.
# GRAFANA_PUBLIC_URL=https://example.com/grafana

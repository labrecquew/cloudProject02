          "editorMode": "code",
          "expr": "sum by (status) (rate(weather_requests_finished_total{job=\"weather-monitor\"}[$__rate_interval])) * 60",
          "refId": "A",
          "legendFormat": "{{status}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "Completed and failed jobs per minute. This measures finished jobs, not HTTP acceptance.",

          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "Each bar is a three-hour forecast in Eastern time.",
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 1,
          "noValue": "No recent data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "axisLabel": "Temperature forecast",
            "fillOpacity": 75
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Forecast time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:MMM D, h:mm A"
              },
              {
                "id": "custom.axisLabel",
                "value": "Forecast time (Eastern)"
              },
              {
                "id": "noValue",
                "value": ""
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "vertical",
        "xField": "Forecast time",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 120,
        "showValue": "never",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.65,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "transformations": [
        {
          "id": "organize",
          "filter": {
            "id": "byRefId",
            "options": "A"
          },
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "zip": true,
              "request_id": true
            },
            "renameByName": {
              "Value": "Forecast time",
              "Value #A": "Forecast time"
            }
          }
        },
        {
          "id": "organize",
          "filter": {
            "id": "byRefId",
            "options": "B"
          },
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,

              "zip": true,
              "request_id": true
            },
            "renameByName": {
              "Value": "Temperature",
              "Value #B": "Temperature"
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "step",
            "mode": "outerTabular"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Forecast time",
                "desc": false

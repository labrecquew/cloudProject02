    {
      "id": 1,
      "type": "text",
      "title": "Forecast guide",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Choose a **ZIP code** above. Temperatures are **Fahrenheit** and wind is **mph**. Charts show the future times predicted by the latest completed request. Times use the browser time zone.\n\nNo forecast? Submit a request through the application, then refresh. Current snapshots expire after 30 minutes; a shorter request replaces the previous forecast for that ZIP."
      }
    },
    {
      "id": 2,
      "title": "Forecast high",
      "type": "stat",
      "pluginVersion": "12.2.0",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(weather_forecast_temperature_celsius{job=\"weather-monitor\",zip=\"$zip\"}) * 9 / 5 + 32",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "",
